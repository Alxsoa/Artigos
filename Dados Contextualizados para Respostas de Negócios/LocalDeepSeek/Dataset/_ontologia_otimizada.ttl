@prefix : <http://example.org/turing#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology ;
    rdfs:label "Ontologia Alan Turing - Alta Qualidade"@pt ;
    rdfs:comment "Ontologia otimizada sobre Alan Turing com hierarquia profunda e alta riqueza semântica"@pt .

:AlanTuring a :CientistaDaComputacao,
        :Criptografo,
        :Matematico ;
    rdfs:label "Alan Mathison Turing"@pt ;
    :biografia "Pai da computação moderna e herói da Segunda Guerra Mundial" ;
    :contribuiuPara :InteligenciaArtificial ;
    :dataMorte "1954-06-07"^^xsd:date ;
    :dataNascimento "1912-06-23"^^xsd:date ;
    :desenvolveu :TeoriaComputabilidade ;
    :doutoradoEm :UniversidadePrinceton ;
    :especializadoEm :CienciaComputacao,
        :Criptografia ;
    :estudouEm :UniversidadeCambridge ;
    :inventou :Bombe,
        :MaquinaTuring ;
    :morreuEm :ReinoUnido ;
    :nacionalidade "Britânico" ;
    :nasceuEm :Londres ;
    :nomeCompleto "Alan Mathison Turing" ;
    :participouDe :SegundaGuerraMundial ;
    :primeiroNome "Alan" ;
    :profissao "Matemático, Criptanalista, Cientista da Computação" ;
    :propôs :TesteTuring ;
    :publicou :ArtigoComputingMachinery ;
    :sobrenome "Turing" ;
    :trabalhouEm :BletchleyPark,
        :GCCS .

